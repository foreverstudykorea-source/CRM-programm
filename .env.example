# Copy to .env.local for local development. Never commit real values.

# Postgres connection string (Vercel → Storage → Neon adds it automatically).
# Leave empty locally to use the built-in PGlite database in ./.data/pglite.
DATABASE_URL=

# Required in production: at least 32 random characters.  openssl rand -base64 32
SESSION_SECRET=

# One-time key for the /setup page that creates the first administrator (16+ characters).
SETUP_TOKEN=

# Optional, default Asia/Tashkent
APP_TIMEZONE=Asia/Tashkent
